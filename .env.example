# IndexNode environment template. Copy to .env and fill in real values.
# Variables marked REQUIRED will cause indexnode-api to fail fast on startup
# if unset. Variables marked OPTIONAL have documented defaults or feature-flag
# the relevant subsystem off when absent.

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string. Used by the API and embedded worker.
DATABASE_URL=postgres://indexnode:CHANGE_ME@localhost:5432/indexnode

# ── Server ────────────────────────────────────────────────────────────────────
# OPTIONAL. Tracing filter. Defaults to "info".
RUST_LOG=info
# OPTIONAL. HTTP listen port. Defaults to 3000.
PORT=3000
# OPTIONAL. CORS allow-list. Defaults to http://localhost:3000. In production
# set to the exact origin the frontend is served from (e.g. https://indexnode.io).
ALLOWED_ORIGIN=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. Symmetric secret for HS256 JWT signing. Generate ≥256 bits of
# entropy and rotate periodically. Compromise of this value lets an attacker
# forge any session.
JWT_SECRET=

# REQUIRED IN PRODUCTION. Set to 1 in any non-localhost deployment so the
# auth_token cookie is marked Secure (browsers refuse to send it over HTTP).
# Leave unset for local dev over plain HTTP.
COOKIE_SECURE=

# ── Ethereum / contracts ──────────────────────────────────────────────────────
# REQUIRED. WebSocket RPC for the primary chain. Used for event indexing and
# on-chain credit/timestamp operations.
ETHEREUM_RPC_URL=ws://127.0.0.1:8546
# OPTIONAL. Set to a Polygon WebSocket RPC to enable Polygon indexing.
POLYGON_RPC_URL=

# REQUIRED. Deployed CreditToken (INC) address — owner of the embedded worker
# uses this to call spendCredits.
CREDIT_CONTRACT_ADDRESS=
# REQUIRED. Private key the backend uses to sign spendCredits transactions.
# Must be the owner of CreditToken (i.e. the MULTISIG_OWNER from deploy, or a
# delegated operator key). Held in memory wrapped in Zeroizing.
CREDIT_PRIVATE_KEY=
# REQUIRED. Deployed DataMarketplace proxy address.
MARKETPLACE_CONTRACT_ADDRESS=
# OPTIONAL. Deployed TimestampRegistry proxy address. When unset, on-chain
# Merkle commitments are disabled (worker logs a warn at startup).
TIMESTAMP_REGISTRY_ADDRESS=

# ── AI extraction ─────────────────────────────────────────────────────────────
# OPTIONAL. Anthropic API key for the AI extraction worker. When unset, AI
# extraction is disabled (the rest of the worker still runs).
ANTHROPIC_API_KEY=

# ── IPFS ──────────────────────────────────────────────────────────────────────
# OPTIONAL. Local IPFS daemon URL. Used only when PINATA_JWT is unset.
IPFS_API_URL=http://127.0.0.1:5001
# OPTIONAL. Pinata JWT. When set, all pinning goes through Pinata's HTTP API
# (third-party persistence). When unset, content is pinned to the local daemon
# at IPFS_API_URL only — startup logs a warn so operators know there is no
# third-party redundancy.
PINATA_JWT=

# ── Email (password reset) ────────────────────────────────────────────────────
# OPTIONAL. Resend API key. When unset, password reset emails are not sent
# (the rest of the password-reset flow still works for testing).
RESEND_API_KEY=
# OPTIONAL. Base URL embedded in reset-password links. Defaults to https://indexnode.io.
BASE_URL=https://indexnode.io

# ── Timeouts ──────────────────────────────────────────────────────────────────
# OPTIONAL. All values are in seconds. Defaults are sensible for prod.
CRAWL_TIMEOUT_SECS=120
AI_TIMEOUT_SECS=30
WEBHOOK_TIMEOUT_SECS=10

# ── CLI ───────────────────────────────────────────────────────────────────────
# OPTIONAL. Override for the CLI's API target.
API_URL=http://127.0.0.1:3000
